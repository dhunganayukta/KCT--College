@page
@model KCT_College.Models.User.CreateModel

<h4>Registration</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Registration.Name" class="control-label"></label>
                <input asp-for="Registration.Name" class="form-control" />
                <span asp-validation-for="Registration.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registration.Description" class="control-label"></label>
                <input asp-for="Registration.Description" class="form-control" />
                <span asp-validation-for="Registration.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registration.Address" class="control-label"></label>
                <input asp-for="Registration.Address" class="form-control" />
                <span asp-validation-for="Registration.Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registration.city" class="control-label"></label>
                <input asp-for="Registration.city" class="form-control" />
                <span asp-validation-for="Registration.city" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registration.Phone" class="control-label"></label>
                <input asp-for="Registration.Phone" class="form-control" />
                <span asp-validation-for="Registration.Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
