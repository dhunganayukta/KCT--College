@{
    ViewData["Title"] = "Registration";
}
<h2>Registration Form</h2>

<form id="regForm">
    <div class="mb-3">
        <label>Name</label>
        <input name="Name" class="form-control" id="Name" required />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <input type="text" name="Description" class="form-control" id="Description" required />
    </div>
    <div class="mb-3">
        <label>Address</label>
        <input type="text" name="Address" class="form-control" id="Address" required />
    </div>
    <div class="mb-3">
        <label>City</label>
        <input type="text" name="City" class="form-control" id="City" required />
    </div>
    <div class="mb-3">
        <label>Phone</label>
        <input type="text" name="Phone" class="form-control" id="Phone" required />
    </div>

    <button type="submit" class="btn btn-primary">Register</button>
</form>

<div class="table-container mt-4">
    <table id="itemsTable" class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Address</th>
                <th>City</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    $(document).ready(function () {
        loadItems();

        $("#regForm").on("submit", function (e) {
            e.preventDefault();

            const data = {
                Name: $("#Name").val(),
                Description: $("#Description").val(),
                Address: $("#Address").val(),
                City: $("#City").val(),
                Phone: $("#Phone").val()
            };

            $.ajax({
                url: "/Registration/CreateJson",  // Updated URL to JSON API endpoint
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data)
            })
            .done(function (res) {
                alert("Registration successful!");
                $("#regForm")[0].reset();
                loadItems();
            })
            .fail(function (xhr) {
                alert("Error: " + xhr.responseText);
            });
        });

        function loadItems() {
            $.get("/Registration/GetAll", function (data) {
                const rows = data.map(item => `
                    <tr>
                        <td>${item.id}</td>
                        <td>${item.name}</td>
                        <td>${item.description}</td>
                        <td>${item.address}</td>
                        <td>${item.city}</td>
                        <td>${item.phone}</td>
                        <td>
                            <button class="btn btn-sm btn-warning" onclick="editItem(${item.id})">Edit</button>
                            <button class="btn btn-sm btn-danger" onclick="deleteItem(${item.id})">Delete</button>
                        </td>
                    </tr>
                `);
                $("#itemsTable tbody").html(rows.join(""));
            });
        }
    });

    function editItem(id) {
        alert("Edit item " + id);
        // Implement edit functionality as needed
    }

    function deleteItem(id) {
        if (confirm("Are you sure you want to delete this item?")) {
            $.ajax({
                url: `/Registration/DeleteJson/${id}`, // Updated URL to JSON Delete endpoint
                type: "POST"
            })
            .done(function() {
                alert("Deleted successfully");
                loadItems();
            })
            .fail(function(xhr) {
                alert("Delete failed: " + xhr.responseText);
            });
        }
    }
</script>
